+/* Poly pressure addresses the original MIDI key, not a guessed sounding pitch.
+ * Chord tones share their key's level; channels without that key own nothing. */
+static void midi_pressure_event(uint32_t ch, uint32_t note, uint32_t value)
+{
+    uint32_t id = midi_note_get(ch, note) & 0x7Fu, i;
+    mchord_t *m;
+    if (!id)
+        return;
+    m = mchord_of(ch, note, id);
+    if (m) {
+        for (i = 0; i < m->n; i++)
+            expr_pressure(&trk[id - 1u], m->note[i], value);
+    } else
+        expr_pressure(&trk[id - 1u], note, value);
 }
 
