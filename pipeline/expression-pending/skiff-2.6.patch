+static void expr_pressure(track_t *t, uint32_t key, uint32_t value)
+{
+    uint32_t p = (uint32_t)(t - trk), i;
+    expr_depth[p][key] = (uint8_t)(127u - value);
+    for (i = 0; i < NVOICE; i++)
+        if (t->v[i].active && expr_voice[p][i] == key + 1u)
+            expr_gain[p][i] = expr_depth[p][key];
+}
+
+static void expr_press(track_t *t, uint32_t key)
+{
+    expr_live[t - trk][key] = 1;
+    expr_pressure(t, key, 127);
+}
