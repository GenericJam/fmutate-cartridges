+/* Active MIDI bend channel followed by panel keys and internal voices */
+static inline uint32_t fm106_key_bend_ch(const fm106_engine_t *e)
+{
+    if (e->midi_channel >= 1u && e->midi_channel <= 16u)
+        return (uint32_t)(e->midi_channel - 1u);
+    if (e->midi_out_ch >= 1u && e->midi_out_ch <= 16u)
+        return (uint32_t)(e->midi_out_ch - 1u);
+    return 0u;
+}
+
+/* 1/4096 semitone (+-8192 = +-2 st) -> Q16 ~2^(s/12) */
+static inline uint32_t fm106_bend_to_q16(int32_t bd)
+{
+    int32_t s2;
+    if (bd < -8192) bd = -8192;
+    else if (bd > 8192) bd = 8192;
+    s2 = (bd * bd) >> 12;
+    return (uint32_t)(65536 + ((bd * 3786) >> 12) + ((s2 * 109) >> 12) + ((((s2 * bd) >> 12) * 2) >> 12));
+}
+
+/* Square-law polyphonic key pressure: 0 silent, 127 unity, (val/127)^2 in Q15 */
+static inline uint16_t fm106_at_gain_q15(uint32_t val)
+{
+    if (val >= 127u) return 32767u;
+    return (uint16_t)((val * val * 133141u) >> 16);
+}
