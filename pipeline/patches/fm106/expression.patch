+/* MIDI polyphonic key pressure (0xAn): isolated per MIDI channel and source key */
+static void fm106_pressure(fm106_engine_t *e, uint32_t ch, uint32_t note, uint32_t val)
+{
+    if (ch >= 16u || note > 127u) {
+        return;
+    }
+    uint16_t g = fm106_at_gain_q15(val);
+    fm1_irq_off();
+#if DINGHY_DUAL_CORE
+    if (audio_worker_online) audio_worker_join();
+#endif
+    if (e->key_ch_mask[note] & (1u << ch)) {
+        e->key_at[ch][note] = (uint8_t)(val > 127u ? 127u : val);
+    }
+    for (uint32_t i = 0; i < FM106_NUM_VOICES; i++) {
+        fm106_voice_t *v = &e->voice[i];
+        if (v->ch == (uint8_t)ch && v->src_note == (uint8_t)note &&
+            (v->gate || (e->arp_on && (e->key_ch_mask[note] & (1u << ch))))) {
+            v->at_q15 = g;
+        }
+    }
+    fm1_irq_on();
+}
