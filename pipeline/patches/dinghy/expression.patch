+static volatile uint32_t bend_q16[17] = {
+    65536u, 65536u, 65536u, 65536u, 65536u, 65536u, 65536u, 65536u,
+    65536u, 65536u, 65536u, 65536u, 65536u, 65536u, 65536u, 65536u, 65536u
+};
+static int32_t midi_bend[16], wheel_bend;       /* volatile performance state: 1/4096 semitone (+-8192 = +-2 st) */
+static uint32_t key_bend_ch;                    /* the MIDI channel whose bend the panel keys follow: the one they send on */
 
+static uint32_t bend_to_q16(int32_t bd)         /* 1/4096 semitone (+-8192 = +-2 st) -> Q16 ~2^(s/12) */
+{
+    int32_t s2;
+    if (bd < -8192) bd = -8192;
+    else if (bd > 8192) bd = 8192;
+    s2 = (bd * bd) >> 12;
+    return (uint32_t)(65536 + ((bd * 3786) >> 12) + ((s2 * 109) >> 12) + ((((s2 * bd) >> 12) * 2) >> 12));
+}
+static uint32_t wheel_q16(int32_t bd)          /* the wheel alone: the stock curve, exactly (~2^(s/12)) */
+{
+    return (uint32_t)(65536 + (bd * 3785 >> 12) + (((bd * bd) >> 12) * 109 >> 12));
+}
+static uint32_t channel_q16(int32_t midi)       /* a MIDI bend (+ the wheel): the closer curve; none: stock */
+{
+    return midi ? bend_to_q16(midi + wheel_bend) : wheel_q16(wheel_bend);
+}
+static void bend_update(uint32_t ch)
+{
+    if (ch < 16u) bend_q16[ch] = channel_q16(midi_bend[ch]);
+    if (ch >= 16u || ch == key_bend_ch)
+        bend_q16[KEY_CH] = channel_q16(midi_bend[key_bend_ch]);
+}
+static uint32_t at_gain_q15(uint32_t val)       /* square-law poly pressure: 0 silent, 127 unity, (val/127)^2 Q15 */
+{
+    if (val >= 127u) return 32767u;
+    return (val * val * 133141u) >> 16;
+}
