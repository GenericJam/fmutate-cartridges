+static void pressure(uint32_t ch, uint32_t note, uint32_t val)
+{
+    uint32_t v, g = at_gain_q15(val);
+    if (note > 127u) return;
+    for (v = 0; v < NV; v++)
+        if (voice[v].note == note && voice[v].ch == ch && (voice[v].gate || voice[v].amp))
+            voice[v].at_q15 = g;
+}
+static void midi_reset_ch(uint32_t ch, int release_notes)
+{
+    uint32_t v;
+    midi_bend[ch] = 0;
+    bend_update(ch);
+    for (v = 0; v < NV; v++) {
+        if (voice[v].ch != ch) continue;
+        if (release_notes) voice[v].gate = 0;
+        else if (voice[v].gate) voice[v].at_q15 = 32767u;
+    }
+}
