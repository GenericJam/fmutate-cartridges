+    for (i = 0; i < t->xp_n; i++)
+        if (t->xp_note[i] == snote)
+            expr_xp_owner[p][i] = owner;
+    for (i = 0; i < t->seq_n; i++) {
+        uint32_t sqn = t->seq_notes[i];
+        uint32_t sqs = fol_map[p][sqn & 127u] ? (uint32_t)fol_map[p][sqn & 127u] - 1u : sqn;
+        if (sqn == note || sqs == snote)
+            seq_on = 1;
+    }
+    if (seq_on)
+        return;
+    for (i = 0; i < sq[p].n; i++)
+        if (sq[p].note[i] == note)
+            sq[p].owner[i] = owner;
+    for (i = 0; i < t->nmono; i++)
+        if (t->mono_stack[i] == snote)
+            expr_mono_owner[p][i] = owner;
+    if (trk_vmode(t) != V_POLY) {
+        if (t->mono_note == snote) {
+            uint32_t nv = trk_vmode(t) == V_UNISON ? uni_nvoice(t) : 1u;
+            expr_cur_owner = expr_mono_pick(t);
+            for (i = 0; i < nv; i++)
