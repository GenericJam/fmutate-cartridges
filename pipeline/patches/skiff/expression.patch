+static void expr_fol_collision(track_t *t, uint32_t o)
+{
+    uint32_t p = trk_index(t), snote = o - 1u, i, seq_on = 0, panel = 0, found = 0;
+    uint16_t owner = 0;
+    for (i = 0; i < t->seq_n; i++) {
+        uint32_t sqn = t->seq_notes[i];
+        uint32_t sqs = fol_map[p][sqn & 127u] ? (uint32_t)fol_map[p][sqn & 127u] - 1u : sqn;
+        if (sqn == snote || sqs == snote)
+            seq_on = 1;
+    }
+    if (seq_on)
+        return;
+    for (i = 0; i < 128u; i++) {
+        if (fol_map[p][i] != o)
+            continue;
+        if (midi_local_held(t, i)) {
+            panel = 1;
+            break;
+        }
+        if (!found && midi_note_held(t, i)) {
+            owner = midi_owner_of(t, i);
+            found = 1;
+        }
+    }
+    if (!panel && !found)
+        return;
+    if (panel)
+        owner = 0;
+    for (i = 0; i < t->xp_n; i++)
+        if (t->xp_note[i] == snote)
+            expr_xp_owner[p][i] = owner;
+    for (i = 0; i < t->nmono; i++)
+        if (t->mono_stack[i] == snote)
+            expr_mono_owner[p][i] = owner;
+    if (trk_vmode(t) != V_POLY) {
+        if (t->mono_note == snote) {
+            uint32_t nv = trk_vmode(t) == V_UNISON ? uni_nvoice(t) : 1u;
+            expr_cur_owner = expr_mono_pick(t);
+            for (i = 0; i < nv; i++)
+                if (t->v[i].active && t->v[i].gate)
+                    expr_bind(t, &t->v[i]);
+        }
+        return;
+    }
+    if (!t->p[P_AMODE] || in_solo) {
+        expr_cur_owner = owner;
+        for (i = 0; i < NVOICE; i++)
+            if (t->v[i].active && t->v[i].gate && t->v[i].note == snote)
+                expr_bind(t, &t->v[i]);
+    }
+}
