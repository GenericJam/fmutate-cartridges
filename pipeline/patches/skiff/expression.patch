+static uint16_t midi_owner_of(const track_t *t, uint32_t note)
+{
+    uint32_t ch, m, j, id = trk_index(t) + 1u;
+    for (ch = 0; ch < 16u; ch++)
+        if ((midi_notes[ch][note] & 0x7Fu) == id && !mchord_of(ch, note, id))
+            return (uint16_t)(1u + (ch << 7) + note);
+    for (m = 0; m < MCHORD_N; m++)
+        if (mchord[m].id == id)
+            for (j = 0; j < mchord[m].n; j++)
+                if (mchord[m].note[j] == note)
+                    return (uint16_t)(1u + ((mchord[m].ch & 15u) << 7) + (mchord[m].src & 127u));
+    return 0;
+}
