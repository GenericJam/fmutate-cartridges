+static int expr_held(const track_t *t, uint16_t owner);
+static void expr_drop_owner(track_t *t, uint16_t owner)
+{
+    uint32_t ch, key, p = trk_index(t), v;
+    if (!owner || expr_held(t, owner))
+        return;
+    ch = (owner - 1u) >> 7;
+    key = (owner - 1u) & 127u;
+    if (ch < 16u)
+        expr_depth[ch][key] = 0;
+    for (v = 0; v < NVOICE; v++)
+        if (expr_voice[p][v] == owner)
+            expr_voice[p][v] = 0;
+}
+
+static void expr_clear_held(track_t *t)
+{
+    uint32_t p = trk_index(t), i, n = t->nheld > expr_held_n[p] ? t->nheld : expr_held_n[p];
+    uint16_t old[16];
+    if (n > 16u)
+        n = 16u;
+    for (i = 0; i < n; i++) {
+        old[i] = expr_held_src[p][i];
+        expr_held_src[p][i] = 0;
+    }
+    t->nheld = 0;
+    expr_held_n[p] = 0;
+    for (i = 0; i < n; i++)
+        if (old[i])
+            expr_drop_owner(t, old[i]);
+}
